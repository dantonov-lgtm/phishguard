{
  "manifest_version": 3,
  "name": "PhishGuard Local Scanner",
  "version": "1.0.0",
  "description": "Checks the open message for common phishing warning signs using a local scanner.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Scan this message",
    "default_popup": "popup.html"
  }
}
